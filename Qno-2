print("PREDICTIVE MACHINE MAINTENANCE USING HMM")
print("------------------------------------------")
print("\nHidden States:")
print(states)
print("\nSensor Observations:")
print([
    observations[i]
    for i in sensor_observations
])
print("\nPredicted Hidden Machine States:")
for i in range(n_observations):
    print(
        observations[sensor_observations[i]],
        "->",
        states[hidden_states[i]]
    )
print("\nFinal Predicted Machine State:")
print(states[hidden_states[-1]])
